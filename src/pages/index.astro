---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { formatSumiDate } from '../utils/formatDate';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts[0];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="home-hero">
				<div class="home-hero__inner">
					<div class="home-hero__mark">
						<svg viewBox="0 0 100 100" width="92" height="92" aria-hidden="true">
							<circle
								cx="50"
								cy="50"
								r="38"
								fill="none"
								stroke="currentColor"
								stroke-width="2.8"
								stroke-dasharray="218 26"
								stroke-dashoffset="-12"
								stroke-linecap="round"
								transform="rotate(-130 50 50)"
							></circle>
						</svg>
					</div>
					<p class="eyebrow eyebrow--center home-hero__date">11 . v . 2026</p>
					<h1 class="home-hero__title">One pedal stroke,<br />then another.</h1>
				</div>
			</section>

			{
				latest && (
					<section class="home-entry">
						<div class="home-entry__inner">
							<p class="eyebrow home-entry__label">Latest</p>
							<a class="home-entry__link" href={`/blog/${latest.id}/`}>
								<h2 class="home-entry__title">{latest.data.title}</h2>
								<p class="home-entry__excerpt">{latest.data.description}</p>
							</a>
							<p class="home-entry__all">
								<a href="/blog">All entries</a>
							</p>
						</div>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>
