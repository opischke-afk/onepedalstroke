---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

const sorted = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const i = sorted.findIndex((p) => p.id === post.id);
const newer = sorted[i - 1];
const older = sorted[i + 1];
const prev = older ? { id: older.id, title: older.data.title } : undefined;
const next = newer ? { id: newer.id, title: newer.data.title } : undefined;
---

<BlogPost {...post.data} prev={prev} next={next}>
	<Content />
</BlogPost>
