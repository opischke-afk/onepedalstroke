---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { formatSumiDate } from '../../utils/formatDate';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`All entries — ${SITE_TITLE}`} description="All entries." />
	</head>
	<body>
		<Header />
		<main>
			<section class="archive">
				<p class="eyebrow eyebrow--center archive__label">All entries</p>
				<ul class="archive__list">
					{
						posts.map((post) => (
							<li class="archive__item">
								<p class="archive__date">{formatSumiDate(post.data.pubDate)}</p>
								<a class="archive__link" href={`/blog/${post.id}/`}>
									<h2 class="archive__title">{post.data.title}</h2>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
