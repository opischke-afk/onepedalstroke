---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { formatSumiDate } from '../utils/formatDate';

type Props = CollectionEntry<'blog'>['data'] & {
	prev?: { id: string; title: string };
	next?: { id: string; title: string };
};

const { title, description, pubDate, distance, duration, prev, next } = Astro.props;

const metaBits = [formatSumiDate(pubDate), distance, duration].filter(Boolean);
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article class="article">
				<p class="eyebrow eyebrow--center article__meta">{metaBits.join(' · ')}</p>
				<h1 class="article__title">{title}</h1>
				<hr class="rule article__rule" />
				<slot />
			</article>
			<nav class="article-nav">
				{
					prev ? (
						<a href={`/blog/${prev.id}/`}>Previous</a>
					) : (
						<span class="is-disabled">Previous</span>
					)
				}
				<a href="/">Index</a>
				{
					next ? (
						<a href={`/blog/${next.id}/`}>Next</a>
					) : (
						<span class="is-disabled">Next</span>
					)
				}
			</nav>
		</main>
		<Footer />
	</body>
</html>
